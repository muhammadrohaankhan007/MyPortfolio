datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  techStack   String
  githubUrl   String?
  liveUrl     String?
  createdAt   DateTime @default(now())
}

model Analytics {
  id        String   @id @default(cuid())
  path      String   @unique @default("/")
  views     Int      @default(0)
  updatedAt DateTime @updatedAt
}
